# ==============================================================================
# UCR Division of Television Studies (Batch 11 — 2026 Intake)
# Environment Configuration Template (.env.example)
# Copy this file to .env.local and populate with your production credentials
# ==============================================================================

# 1. Server & Host Configuration
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. JWT & Session Security
# Generate a secure 64-character random string with: openssl rand -base64 32
JWT_SECRET=your_secure_random_jwt_secret_here

# 3. Supabase Database & Realtime (PostgreSQL)
# From Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key_here

# 4. Cloudflare R2 Object Storage (For Large File Uploads & Disaster Recovery Backups)
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token (Admin Read/Write)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ucr-portal-assets
R2_PUBLIC_DOMAIN=https://your-custom-domain.com
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# 5. Default Institutional SuperAdmin Credentials
# Set strong institutional passwords for first deployment
INITIAL_SUPERADMIN_USERNAME=ucrtvrepb11
INITIAL_SUPERADMIN_PASSWORD="YourStrongAdminPasswordHere#2026"
